#!/bin/sh
# Pre-push guardrails. Order matters: secret + foreign-commit checks run (and
# can exit) BEFORE the slow `pnpm build`. `git push --no-verify` skips ALL of
# this, which is why CI also runs scripts/check-secrets.sh on every PR.
#
# git feeds one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>

zero="0000000000000000000000000000000000000000"
base="origin/main"
fetched=0
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  # Branch/tag deletes carry an all-zero local sha: nothing to scan.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$fetched" = 0 ]; then
    git fetch -q origin main 2>/dev/null || true
    fetched=1
    if ! git rev-parse -q --verify "$base" >/dev/null 2>&1; then
      # Fail CLOSED: a guard that silently skips is worse than none.
      echo "pre-push: $base not found, so the secret/foreign-commit checks can't run. Push refused." >&2
      echo "  Fix: git fetch origin main   (or push with --no-verify if you are sure; CI still scans)" >&2
      exit 1
    fi
  fi

  # (i) secrets in everything this push adds on top of main (catches --no-verify commits).
  # Three-dot = diff from the merge-base, so a moved main doesn't show up as "added" lines.
  if ! sh scripts/check-secrets.sh --range "$base...$local_sha"; then
    echo "pre-push: secret scan failed for $local_ref. Push refused." >&2
    fail=1
  fi

  # (ii) foreign commits: unpushed commits that ALSO sit on a different local branch.
  # That is the "cut the branch from another feature branch" mistake that published
  # a password on 2026-10-16: the other branch's unpushed commits ride along.
  if [ "${ALLOW_FOREIGN_COMMITS:-}" != "1" ]; then
    pushed_branch=${local_ref#refs/heads/}
    if [ "$local_ref" = "HEAD" ]; then
      pushed_branch=$(git symbolic-ref -q --short HEAD || true)
    fi
    others=$(git for-each-ref refs/heads --format='%(refname:short)' | { grep -vxF -- "$pushed_branch" || true; })
    foreign=""
    # Fail CLOSED if the commit list can't be computed (otherwise the loop runs 0 times).
    if ! commits=$(git rev-list "$base..$local_sha"); then
      echo "pre-push: couldn't list commits for $local_ref. Push refused." >&2
      exit 1
    fi
    for c in $commits; do
      # Already on some remote branch = already public, not a new leak.
      [ -z "$(git branch -r --contains "$c" 2>/dev/null)" ] || continue
      owners=""
      for b in $others; do
        if git merge-base --is-ancestor "$c" "refs/heads/$b" 2>/dev/null; then
          owners="$owners $b"
        fi
      done
      if [ -n "$owners" ]; then
        foreign="$foreign
  $(git log -1 --format='%h %s' "$c")   [also on:$owners]"
      fi
    done
    if [ -n "$foreign" ]; then
      cat >&2 <<MSG

pre-push: refusing to push $local_ref. It contains unpushed commits that belong to another local branch:
$foreign

These commits belong to another local branch. Did you branch from it instead of origin/main?
Recreate with: git checkout -b <name> origin/main && git cherry-pick <your commits>
If this is an intentional stacked branch, re-run with ALLOW_FOREIGN_COMMITS=1
MSG
      fail=1
    fi
  fi
done

[ "$fail" = 0 ] || exit 1

echo "🔨 Running pnpm build (the real CI gate) — skip with git push --no-verify when iterating"
pnpm build
